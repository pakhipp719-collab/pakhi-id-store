PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
WHATSAPP_NUMBER=9296271001
SITE_NAME=NISHAD BRAND

UPI_VPA=your-upi-id@bank
UPI_NAME=NISHAD BRAND

# Separate long random key for encrypting inventory IDs/passwords at rest
INVENTORY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Cloudflare Turnstile (protects UTR submission)
CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Long random secret shared only between Render backend and your authorized Merchant Verify app
MOBILE_APP_TOKEN=replace-with-a-new-32-plus-character-random-secret
