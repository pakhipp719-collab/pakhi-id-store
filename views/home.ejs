<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= siteName %></title><link rel="stylesheet" href="/style.css"></head><body><header><div class="brand"><div class="brand-mark">P</div><span class="brand-name">PAKHI<small>ID STORE</small></span></div><nav class="header-actions"><a class="button find-id-button" href="#find-id" id="openFind">🔎 Find ID</a><a class="button secondary admin-link" href="/admin/login">Admin Login</a></nav></header><main><section class="hero"><p class="tag">WELCOME TO PAKHI</p><div class="stock">● Available stock: <%= stock %> IDs</div></section><div class="dashboard-grid"><section class="panel pack-panel"><p class="section-tag">CHOOSE A PACK</p><h1>Select Number of IDs</h1><p class="muted">Har ID ki keemat ₹120 hai.</p><div class="packs"><% packs.forEach((p,i)=>{ %><button class="pack <%= i===0?'selected':'' %>" type="button" data-qty="<%= p.qty %>" data-amount="<%= p.amount %>"><small><%= ['STARTER','DUO PACK','VALUE PACK','BULK PACK','MEGA PACK','MAX PACK'][i] || 'ID PACK' %></small><strong><%= p.qty %> ID<%= p.qty>1?'s':'' %></strong><span>₹<%= p.amount.toLocaleString('en-IN') %></span><em>₹120 / ID</em></button><% }) %></div><form method="post" action="/order" class="order-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="qty" id="qty" value="1"><div class="qrbox" id="paymentBox"><h3>✨ UPI Payment QR</h3><p>Pack choose karein, phir QR banayein. QR scan karke payment karein.</p><img id="qr" alt="UPI payment QR" hidden><p id="qrinfo" aria-live="polite"></p><button id="makeqr" class="button" type="button">🛍️ Buy Now · ₹120</button><div id="utrStep" class="utr-step" hidden><div class="payment-ready">✓ QR ready — payment karne ke baad hi UTR submit karein</div><label for="utrInput">Payment UTR / RRN</label><input id="utrInput" name="utr" minlength="6" maxlength="32" autocomplete="off" placeholder="Payment ke baad UTR / RRN enter karein" required disabled><button class="button continue-button" id="submitUtr" type="submit" disabled>Submit UTR · ₹120</button></div></div></form><p class="hint demo-note">Demo only: yahan real payment nahi hota aur stock live server se sync hona chahiye.</p></section><section class="panel process-panel"><p class="section-tag">HOW IT WORKS</p><h2>Order process</h2><p class="muted">Bas chaar simple steps.</p><div class="steps"><div class="step"><b>1</b><div><strong>Pack choose karein</strong><p>1, 2, 5 ya 10 IDs select karein.</p></div></div><div class="step"><b>2</b><div><strong>QR payment</strong><p>Live website par asli payment QR yahan aayega.</p></div></div><div class="step"><b>3</b><div><strong>UTR submit karein</strong><p>Payment reference verification ke liye bhejein.</p></div></div><div class="step"><b>4</b><div><strong>ID details paayein</strong><p>Payment verify hone ke baad credentials milenge.</p></div></div></div><div class="notice">Yeh sample website hai. Abhi koi real payment process nahi hota.</div></section></div><section class="panel news-panel"><h2>Latest News / Updates</h2><% if(!news.length){ %><p>Abhi koi news nahi hai.</p><% } %><% news.forEach(n=>{ %><article class="news"><h3><%= n.title %></h3><p><%= n.body %></p><small><%= n.created_at %></small></article><% }) %></section><section class="panel find-panel" id="find-id" hidden><button class="modal-close" type="button" id="closeFind" aria-label="Close">×</button><p class="section-tag">ORDER LOOKUP</p><h2>🔎 Find Your ID</h2><p class="hint">Apna UTR / RRN number enter karein. Sirf approved order ki details dikhengi.</p><form id="findForm"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="findUtr">Bank UTR / RRN Number</label><input id="findUtr" name="utr" required minlength="6" maxlength="32" autocomplete="off" placeholder="Enter UTR / RRN number"><button class="button" type="submit" id="fetchIds">🚀 Fetch IDs</button></form><div id="findMessage" class="find-message" role="status" aria-live="polite" hidden></div><div id="findCredentials" hidden></div></section></main><footer>Secure order flow · Payment verification required</footer><script>let selectedQty=1;
const findForm=document.getElementById('findForm');
findForm.addEventListener('submit',async e=>{
 e.preventDefault();
 const button=document.getElementById('fetchIds'),message=document.getElementById('findMessage'),credentials=document.getElementById('findCredentials');
 message.hidden=false; message.className='find-message'; message.textContent='Order check ho raha hai…'; credentials.hidden=true; credentials.replaceChildren(); button.disabled=true;
 try {
  const response=await fetch('/find-id',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(findForm))});
  const data=await response.json();
  if(!response.ok) throw new Error(data.error||'Lookup abhi nahi ho paaya.');
  message.textContent='Order verified. Aapki ID details neeche hain.'; message.classList.add('success');
  credentials.hidden=false; credentials.className='find-credentials';
  data.credentials.forEach((item,index)=>{
   const card=document.createElement('div');card.className='credential';
   const title=document.createElement('strong');title.textContent='ID '+(index+1);
   const user=document.createElement('p');user.textContent='Username: '+item.username;
   const pass=document.createElement('p');pass.textContent='Password: '+item.password;
   card.append(title,user,pass);credentials.append(card);
  });
 } catch(err) { message.textContent=err.message; message.classList.add('error'); }
 finally { button.disabled=false; }
});
document.getElementById('openFind').addEventListener('click',e=>{e.preventDefault();const panel=document.getElementById('find-id');panel.hidden=false;panel.classList.add('modal-open');document.getElementById('findUtr').focus();});document.getElementById('closeFind').addEventListener('click',()=>{const panel=document.getElementById('find-id');panel.hidden=true;panel.classList.remove('modal-open');});
document.querySelectorAll('.pack').forEach(b=>b.addEventListener('click',()=>{selectedQty=+b.dataset.qty;document.getElementById('qty').value=selectedQty;document.getElementById('makeqr').textContent='🛍️ Buy Now · ₹'+(+b.dataset.amount).toLocaleString('en-IN');document.querySelectorAll('.pack').forEach(x=>x.classList.toggle('selected',x===b));document.getElementById('qr').hidden=true;document.getElementById('utrStep').hidden=true;document.getElementById('utrInput').disabled=true;document.getElementById('submitUtr').disabled=true;document.getElementById('qrinfo').textContent='Selected '+selectedQty+' IDs · Total ₹'+(+b.dataset.amount).toLocaleString('en-IN');document.getElementById('submitUtr').textContent='Submit UTR · ₹'+(+b.dataset.amount).toLocaleString('en-IN')}));document.getElementById('makeqr').addEventListener('click',async()=>{const b=document.getElementById('makeqr');b.disabled=true;try{const r=await fetch('/payment-qr/'+selectedQty),d=await r.json();if(!r.ok)throw Error(d.error||'QR error');document.getElementById('qr').src=d.qr;document.getElementById('qr').hidden=false;document.getElementById('qrinfo').textContent='Pay ₹'+(+d.amount).toLocaleString('en-IN')+' to '+d.payee+' ('+d.upi+')';document.getElementById('utrStep').hidden=false;document.getElementById('utrInput').disabled=false;document.getElementById('submitUtr').disabled=false;document.getElementById('submitUtr').textContent='Submit UTR · ₹'+(+d.amount).toLocaleString('en-IN');document.getElementById('utrStep').scrollIntoView({behavior:'smooth',block:'nearest'})}catch(e){alert(e.message)}finally{b.disabled=false}});</script></body></html>
