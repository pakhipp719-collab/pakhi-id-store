<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= siteName %></title><link rel="stylesheet" href="/style.css"></head><body><header><b>✨ <%= siteName %></b><nav class="header-actions"><a class="button find-id-button" href="#find-id" id="openFind">🔎 Find ID</a><a class="button secondary" href="/admin/login">Admin Login</a></nav></header><main><section class="hero"><p class="tag">WELCOME TO PAKHI</p><h1>Apna ID pack choose karein</h1><p><%= s.announcement %></p><div class="stock">Available IDs: <%= stock %></div></section><section class="panel"><h2>Select Number of IDs</h2><div class="packs"><% packs.forEach(p=>{ %><button class="pack" type="button" data-qty="<%= p.qty %>" data-amount="<%= p.amount %>"><strong><%= p.qty %> ID<%= p.qty>1?'s':'' %></strong><span>₹<%= p.amount.toLocaleString('en-IN') %></span></button><% }) %></div><div class="qrbox"><h3>UPI Payment QR</h3><p>Quantity select karne par exact amount ka QR banega.</p><img id="qr" alt="UPI payment QR" hidden><p id="qrinfo"></p><button id="makeqr" class="button" type="button">Generate payment QR</button></div><form method="post" action="/order"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="qty" id="qty" value="1"><label>Payment UTR / RRN</label><input name="utr" required minlength="6" maxlength="32" placeholder="Payment ke baad UTR enter karein"><button class="button" type="submit">Submit order for verification</button></form><p class="hint">Admin bank/UPI app mein payment verify karega. Sirf UTR submit karna payment proof nahi hai.</p></section><section class="panel"><h2>Latest News / Updates</h2><% if(!news.length){ %><p>Abhi koi news nahi hai.</p><% } %><% news.forEach(n=>{ %><article class="news"><h3><%= n.title %></h3><p><%= n.body %></p><small><%= n.created_at %></small></article><% }) %></section>

<section class="panel find-panel" id="find-id"><h2>🔎 Find Your ID</h2><p class="hint">Apna UTR / RRN number enter karein. Sirf approved order ki details dikhengi.</p><form id="findForm"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="findUtr">Bank UTR / RRN Number</label><input id="findUtr" name="utr" required minlength="6" maxlength="32" autocomplete="off" placeholder="Enter UTR / RRN number"><button class="button" type="submit" id="fetchIds">🚀 Fetch IDs</button></form><div id="findMessage" class="find-message" role="status" aria-live="polite" hidden></div><div id="findCredentials" hidden></div></section></main><footer>Secure order flow · Payment verification required</footer><script>let selectedQty=1;
const findForm=document.getElementById('findForm');
findForm.addEventListener('submit',async e=>{
 e.preventDefault();
 const button=document.getElementById('fetchIds'),message=document.getElementById('findMessage'),credentials=document.getElementById('findCredentials');
 message.hidden=false; message.className='find-message'; message.textContent='Order check ho raha hai…'; credentials.hidden=true; credentials.replaceChildren(); button.disabled=true;
 try {
  const response=await fetch('/find-id',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(findForm))});
  const data=await response.json();
  if(!response.ok) throw new Error(data.error||'Lookup abhi nahi ho paaya.');
  message.textContent='Order verified. Aapki ID details neeche hain.'; message.classList.add('success');
  credentials.hidden=false; credentials.className='find-credentials';
  data.credentials.forEach((item,index)=>{
   const card=document.createElement('div');card.className='credential';
   const title=document.createElement('strong');title.textContent='ID '+(index+1);
   const user=document.createElement('p');user.textContent='Username: '+item.username;
   const pass=document.createElement('p');pass.textContent='Password: '+item.password;
   card.append(title,user,pass);credentials.append(card);
  });
 } catch(err) { message.textContent=err.message; message.classList.add('error'); }
 finally { button.disabled=false; }
});
document.getElementById('openFind').addEventListener('click',()=>{document.getElementById('findUtr').focus();});
document.querySelectorAll('.pack').forEach(b=>b.addEventListener('click',()=>{selectedQty=+b.dataset.qty;document.getElementById('qty').value=selectedQty;document.querySelectorAll('.pack').forEach(x=>x.classList.toggle('selected',x===b));document.getElementById('qr').hidden=true;document.getElementById('qrinfo').textContent='Selected '+selectedQty+' IDs · Total ₹'+(+b.dataset.amount).toLocaleString('en-IN')}));document.getElementById('makeqr').addEventListener('click',async()=>{const b=document.getElementById('makeqr');b.disabled=true;try{const r=await fetch('/payment-qr/'+selectedQty),d=await r.json();if(!r.ok)throw Error(d.error||'QR error');document.getElementById('qr').src=d.qr;document.getElementById('qr').hidden=false;document.getElementById('qrinfo').textContent='Pay ₹'+(+d.amount).toLocaleString('en-IN')+' to '+d.payee+' ('+d.upi+')'}catch(e){alert(e.message)}finally{b.disabled=false}});</script></body></html>
