<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= siteName %></title><link rel="stylesheet" href="/style.css"></head><body><header><div class="brand"><div class="brand-mark"><img src="/logo.png" alt="PAKHI logo"></div><span class="brand-name">PAKHI<small>ID STORE</small></span></div><nav class="header-actions"><a class="button find-id-button" href="#find-id" id="openFind">🔎 Find ID</a><a class="button secondary admin-link" href="/admin/login">Admin Login</a></nav></header><main><section class="hero"><p class="tag">WELCOME TO PAKHI</p><div class="stock">● Available stock: <%= stock %> IDs</div></section><div class="dashboard-grid"><section class="panel pack-panel"><p class="section-tag">CHOOSE A PACK</p><h1>Select Number of IDs</h1><p class="muted">Har ID ki keemat ₹120 hai.</p><div class="packs"><% packs.forEach((p,i)=>{ %><button class="pack <%= i===0?'selected':'' %>" type="button" data-qty="<%= p.qty %>" data-amount="<%= p.amount %>"><small><%= ['STARTER','DUO PACK','VALUE PACK','BULK PACK','MEGA PACK','MAX PACK'][i] || 'ID PACK' %></small><strong><%= p.qty %> ID<%= p.qty>1?'s':'' %></strong><span>₹<%= p.amount.toLocaleString('en-IN') %></span><em>₹120 / ID</em></button><% }) %></div><form method="post" action="/order" class="order-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="qty" id="qty" value="1"><div class="qrbox" id="paymentBox"><h3>✨ UPI Payment QR</h3><p>Pack choose karein, phir QR banayein. QR scan karke payment karein.</p><img id="qr" alt="UPI payment QR" hidden><p id="qrinfo" aria-live="polite"></p><button id="makeqr" class="button" type="button">✨ Generate Payment QR</button><div id="utrStep" class="utr-step" hidden><div class="payment-ready">✓ QR ready — payment karne ke baad hi UTR submit karein</div><label for="utrInput">Payment UTR / RRN</label><input id="utrInput" name="utr" minlength="6" maxlength="32" autocomplete="off" placeholder="Payment ke baad UTR / RRN enter karein" required disabled><button class="button continue-button" id="submitUtr" type="submit" disabled>Submit UTR · ₹120</button></div></div></form><p class="hint demo-note">Demo only: yahan real payment nahi hota aur stock live server se sync hona chahiye.</p></section><section class="panel process-panel"><p class="section-tag">HOW IT WORKS</p><h2>Order process</h2><p class="muted">Bas chaar simple steps.</p><div class="steps"><div class="step"><b>1</b><div><strong>Pack choose karein</strong><p>1, 2, 5 ya 10 IDs select karein.</p></div></div><div class="step"><b>2</b><div><strong>QR payment</strong><p>Live website par asli payment QR yahan aayega.</p></div></div><div class="step"><b>3</b><div><strong>UTR submit karein</strong><p>Payment reference verification ke liye bhejein.</p></div></div><div class="step"><b>4</b><div><strong>ID details paayein</strong><p>Payment verify hone ke baad credentials milenge.</p></div></div></div><div class="notice">Yeh sample website hai. Abhi koi real payment process nahi hota.</div></section></div><section class="panel news-panel"><h2>Latest News / Updates</h2><% if(!news.length){ %><p>Abhi koi news nahi hai.</p><% } %><% news.forEach(n=>{ %><article class="news"><h3><%= n.title %></h3><p><%= n.body %></p><small><%= n.created_at %></small></article><% }) %></section><section class="panel find-panel" id="find-id" hidden><button class="modal-close" type="button" id="closeFind" aria-label="Close">×</button><p class="section-tag">ORDER LOOKUP</p><h2>🔎 Find Your ID</h2><p class="hint">Apna UTR / RRN number enter karein. Sirf approved order ki details dikhengi.</p><form id="findForm"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="findUtr">Bank UTR / RRN Number</label><input id="findUtr" name="utr" required minlength="6" maxlength="32" autocomplete="off" placeholder="Enter UTR / RRN number"><button class="button" type="submit" id="fetchIds">🚀 Fetch IDs</button></form><div id="findMessage" class="find-message" role="status" aria-live="polite" hidden></div><div id="findCredentials" hidden></div></section></main><a class="whatsapp-float" href="https://www.whatsapp.com/" target="_blank" rel="noopener noreferrer" aria-label="Open WhatsApp" title="WhatsApp Support"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.9 3 3.1 8.77 3.1 15.88c0 2.27.6 4.48 1.75 6.42L3 29l6.9-1.8a13.1 13.1 0 0 0 6.14 1.52h.01c7.13 0 12.93-5.78 12.93-12.89 0-3.44-1.35-6.67-3.8-9.1A12.85 12.85 0 0 0 16.04 3Zm.01 23.54h-.01a10.8 10.8 0 0 1-5.5-1.5l-.4-.24-4.1 1.07 1.1-4-.26-.41a10.67 10.67 0 0 1-1.65-5.58c0-5.92 4.85-10.74 10.82-10.74 2.89 0 5.6 1.12 7.64 3.15a10.65 10.65 0 0 1 3.17 7.6c0 5.92-4.85 10.75-10.81 10.75Zm5.93-8.05c-.33-.16-1.94-.95-2.24-1.06-.3-.11-.52-.16-.74.16-.22.33-.85 1.06-1.04 1.28-.19.22-.38.25-.71.08-.33-.16-1.39-.51-2.65-1.63-.98-.87-1.64-1.94-1.83-2.27-.19-.33-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.22-.33.33-.55.11-.22.05-.41-.03-.57-.08-.16-.74-1.77-1.02-2.43-.27-.64-.54-.55-.74-.56h-.63c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.71s1.17 3.14 1.33 3.36c.16.22 2.3 3.5 5.58 4.91.78.34 1.39.54 1.87.69.79.25 1.51.21 2.08.13.63-.09 1.94-.79 2.21-1.55.27-.76.27-1.41.19-1.55-.08-.14-.3-.22-.63-.38Z"/></svg><span>WhatsApp</span></a><footer>Secure order flow · Payment verification required</footer><script>let selectedQty=1;
const findForm=document.getElementById('findForm');
findForm.addEventListener('submit',async e=>{
 e.preventDefault();
 const button=document.getElementById('fetchIds'),message=document.getElementById('findMessage'),credentials=document.getElementById('findCredentials');
 message.hidden=false; message.className='find-message'; message.textContent='Order check ho raha hai…'; credentials.hidden=true; credentials.replaceChildren(); button.disabled=true;
 try {
  const response=await fetch('/find-id',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(findForm))});
  const data=await response.json();
  if(!response.ok) throw new Error(data.error||'Lookup abhi nahi ho paaya.');
  message.textContent='Order verified. Aapki ID details neeche hain.'; message.classList.add('success');
  credentials.hidden=false; credentials.className='find-credentials-result';
  const title=document.createElement('div'); title.className='find-credentials-title'; title.textContent='Verified Purchase'; credentials.append(title);
  const terminal=document.createElement('div'); terminal.className='credentials-terminal'; credentials.append(terminal);
  const pairs=[];
  data.credentials.forEach((item,index)=>{
   const pair=String(item.username||'')+(item.password?':'+String(item.password):''); pairs.push(pair);
   const row=document.createElement('div'); row.className='idrow';
   const line=document.createElement('div'); line.className='cred-line';
   const code=document.createElement('code'); code.textContent=pair;
   const copy=document.createElement('button'); copy.type='button'; copy.className='copy-cred'; copy.textContent='▣ Copy';
   copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pair);copy.textContent='✓ Copied';}catch{copy.textContent='Copy failed';}});
   line.append(code,copy); row.append(line); terminal.append(row);
  });
  const actions=document.createElement('div'); actions.className='credentials-actions';
  const copyAll=document.createElement('button'); copyAll.type='button'; copyAll.className='copy-all-cred'; copyAll.textContent='▣ Copy All Credentials';
  copyAll.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pairs.join('\n'));copyAll.textContent='✓ Copied All';}catch{copyAll.textContent='Copy failed';}});
  const download=document.createElement('button'); download.type='button'; download.className='download-credentials'; download.textContent='⇩ Download as TXT';
  download.addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([pairs.join('\n')],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='PAKHI-Credentials.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
  actions.append(copyAll,download); credentials.append(actions);
 } catch(err) { message.textContent=err.message; message.classList.add('error'); }
 finally { button.disabled=false; }
});
document.getElementById('openFind').addEventListener('click',e=>{e.preventDefault();const panel=document.getElementById('find-id');panel.hidden=false;panel.classList.add('modal-open');document.getElementById('findUtr').focus();});document.getElementById('closeFind').addEventListener('click',()=>{const panel=document.getElementById('find-id');panel.hidden=true;panel.classList.remove('modal-open');});
document.querySelectorAll('.pack').forEach(b=>b.addEventListener('click',()=>{selectedQty=+b.dataset.qty;document.getElementById('qty').value=selectedQty;document.querySelector('.continue-button').textContent='Continue to payment · ₹'+(+b.dataset.amount).toLocaleString('en-IN');document.querySelectorAll('.pack').forEach(x=>x.classList.toggle('selected',x===b));document.getElementById('qr').hidden=true;document.getElementById('utrStep').hidden=true;document.getElementById('utrInput').disabled=true;document.getElementById('submitUtr').disabled=true;document.getElementById('qrinfo').textContent='Selected '+selectedQty+' IDs · Total ₹'+(+b.dataset.amount).toLocaleString('en-IN');document.getElementById('submitUtr').textContent='Submit UTR · ₹'+(+b.dataset.amount).toLocaleString('en-IN')}));document.getElementById('makeqr').addEventListener('click',async()=>{const b=document.getElementById('makeqr');b.disabled=true;try{const r=await fetch('/payment-qr/'+selectedQty),d=await r.json();if(!r.ok)throw Error(d.error||'QR error');document.getElementById('qr').src=d.qr;document.getElementById('qr').hidden=false;document.getElementById('qrinfo').textContent='Pay ₹'+(+d.amount).toLocaleString('en-IN')+' to '+d.payee+' ('+d.upi+')';document.getElementById('utrStep').hidden=false;document.getElementById('utrInput').disabled=false;document.getElementById('submitUtr').disabled=false;document.getElementById('submitUtr').textContent='Submit UTR · ₹'+(+d.amount).toLocaleString('en-IN');document.getElementById('utrStep').scrollIntoView({behavior:'smooth',block:'nearest'})}catch(e){alert(e.message)}finally{b.disabled=false}});</script></body></html>
