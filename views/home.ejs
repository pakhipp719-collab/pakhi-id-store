<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= siteName %></title><link rel="stylesheet" href="/style.css"></head><body><header><b>✨ <%= siteName %></b><a class="button" href="/admin/login">Admin Login</a></header><main><section class="hero"><p class="tag">WELCOME TO PAKHI</p><h1>Apna ID pack choose karein</h1><p><%= s.announcement %></p><div class="stock">Available IDs: <%= stock %></div></section><section class="panel"><h2>Select Number of IDs</h2><div class="packs"><% packs.forEach(p=>{ %><button class="pack" type="button" data-qty="<%= p.qty %>" data-amount="<%= p.amount %>"><strong><%= p.qty %> ID<%= p.qty>1?'s':'' %></strong><span>₹<%= p.amount.toLocaleString('en-IN') %></span></button><% }) %></div><div class="qrbox"><h3>UPI Payment QR</h3><p>Quantity select karne par exact amount ka QR banega.</p><img id="qr" alt="UPI payment QR" hidden><p id="qrinfo"></p><button id="makeqr" class="button" type="button">Generate payment QR</button></div><form method="post" action="/order"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="qty" id="qty" value="1"><label>Payment UTR / RRN</label><input name="utr" required minlength="6" maxlength="32" placeholder="Payment ke baad UTR enter karein"><button class="button" type="submit">Submit order for verification</button></form><p class="hint">Admin bank/UPI app mein payment verify karega. Sirf UTR submit karna payment proof nahi hai.</p></section><section class="panel"><h2>Latest News / Updates</h2><% if(!news.length){ %><p>Abhi koi news nahi hai.</p><% } %><% news.forEach(n=>{ %><article class="news"><h3><%= n.title %></h3><p><%= n.body %></p><small><%= n.created_at %></small></article><% }) %></section></main><footer>Secure order flow · Payment verification required</footer><script>let selectedQty=1;document.querySelectorAll('.pack').forEach(b=>b.addEventListener('click',()=>{selectedQty=+b.dataset.qty;document.getElementById('qty').value=selectedQty;document.querySelectorAll('.pack').forEach(x=>x.classList.toggle('selected',x===b));document.getElementById('qr').hidden=true;document.getElementById('qrinfo').textContent='Selected '+selectedQty+' IDs · Total ₹'+(+b.dataset.amount).toLocaleString('en-IN')}));document.getElementById('makeqr').addEventListener('click',async()=>{const b=document.getElementById('makeqr');b.disabled=true;try{const r=await fetch('/payment-qr/'+selectedQty),d=await r.json();if(!r.ok)throw Error(d.error||'QR error');document.getElementById('qr').src=d.qr;document.getElementById('qr').hidden=false;document.getElementById('qrinfo').textContent='Pay ₹'+(+d.amount).toLocaleString('en-IN')+' to '+d.payee+' ('+d.upi+')'}catch(e){alert(e.message)}finally{b.disabled=false}});</script></body></html>
