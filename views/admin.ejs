<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PAKHI Admin Panel</title><link rel="stylesheet" href="/style.css"></head><body><header><b>⚙ PAKHI Admin Panel</b><div><a href="/">View Store</a> <form class="inline" method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="button secondary">Logout</button></form></div></header><main><h1>Admin Dashboard</h1><p class="stock">Available inventory: <%= available %> IDs</p><% if(message){ %><p class="success"><%= message %></p><% } %><div class="admin-grid"><section class="panel"><h2>Store settings</h2><form method="post" action="/admin/settings"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Price per ID (₹)</label><input type="number" min="1" max="100000" name="price_per_id" value="<%= s.price_per_id %>" required><label>UPI ID</label><input name="upi_id" value="<%= s.upi_id %>" placeholder="yourupi@bank"><label>UPI display name</label><input name="upi_name" value="<%= s.upi_name %>"><label>Homepage announcement</label><textarea name="announcement" rows="3"><%= s.announcement %></textarea><button class="button">Save settings</button></form></section><section class="panel"><h2>Add news manually</h2><form method="post" action="/admin/news"><input type="hidden" name="csrf" value="<%= csrf %>"><label>News title</label><input name="title" maxlength="120" required><label>News details</label><textarea name="body" rows="4" maxlength="3000" required></textarea><button class="button">Publish news</button></form><h3>Published news</h3><% news.forEach(n=>{ %><article class="news"><b><%= n.title %></b><p><%= n.body %></p><form method="post" action="/admin/news/<%= n.id %>/delete"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="button danger">Delete</button></form></article><% }) %></section><section class="panel"><h2>Save ID credentials</h2><p>Passwords encrypted at rest.</p><form method="post" action="/admin/inventory"><input type="hidden" name="csrf" value="<%= csrf %>"><label>ID / username</label><input name="username" required maxlength="200"><label>Password</label><input name="password" type="password" required maxlength="500" autocomplete="new-password"><button class="button">Save ID & password</button></form><h3>Recent inventory</h3><div class="tablewrap"><table><tr><th>ID</th><th>Username</th><th>Status</th><th>Order</th><th>Action</th></tr><% inventory.forEach(i=>{ %><tr><td><%= i.id %></td><td><%= i.username %></td><td><%= i.status %></td><td><%= i.order_id||'—' %></td><td><% if(i.status==='available'){ %><form method="post" action="/admin/inventory/<%= i.id %>/delete"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="button danger">Remove</button></form><% } %></td></tr><% }) %></table></div></section><section class="panel"><h2>Orders / UTR verification</h2><p>Actual payment bank/UPI app mein check karke hi approve karein.</p><div class="tablewrap"><table><tr><th>Order</th><th>UTR</th><th>Qty</th><th>Amount</th><th>Status</th><th>Actions</th></tr><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.utr %></td><td><%= o.qty %></td><td>₹<%= o.amount %></td><td><%= o.status %></td><td><% if(o.status==='pending'){ %><form method="post" action="/admin/orders/<%= o.id %>/approve"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="button">Approve & assign IDs</button></form><form method="post" action="/admin/orders/<%= o.id %>/reject"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="button danger">Reject</button></form><% }else if(o.status==='approved'){ %><a class="button" href="/admin/orders/<%= o.id %>/credentials">View credentials</a><% } %></td></tr><% }) %></table></div></section></div></main></body></html>
