<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order status</title><link rel="stylesheet" href="/style.css"></head><body><header><b>PAKHI ID Store</b><a href="/">Home</a></header><main class="narrow"><section class="panel"><h1>Order submitted</h1><p>Order #<%= order.id %></p><p>Quantity: <%= order.qty %></p><p>Amount: ₹<%= order.amount.toLocaleString('en-IN') %></p><p>Status: <strong><%= order.status %></strong></p><p>Admin actual payment verify karne ke baad hi order approve karega.</p><a class="button" href="/">Back to store</a></section></main></body></html>
